{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Om-LifeOS",
  "version": "1.7.4",
  "identifier": "com.lifeos.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Om-LifeOS",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Om-LifeOS — personal life management desktop app",
    "longDescription": "Om-LifeOS is a lightweight local-first personal productivity and life management desktop application for Windows.",
    "icon": [
      "icons/icon.ico",
      "icons/icon-256.png",
      "icons/icon-128.png",
      "icons/icon-64.png",
      "icons/icon-32.png",
      "icons/icon-16.png"
    ],
    "createUpdaterArtifacts": false,
    "android": {
      "versionCode": 1002000
    }
  }
}
