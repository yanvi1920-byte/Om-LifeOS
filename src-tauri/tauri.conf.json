{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Om-LifeOS",
  "version": "4.6.2",
  "identifier": "com.om.lifeos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Om-LifeOS — Personal Operating System",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "transparent": true,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}
