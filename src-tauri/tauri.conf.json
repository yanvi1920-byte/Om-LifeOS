{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ॐ",
  "version": "1.1.6",
  "identifier": "com.lifeos.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "ॐ",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "ॐ — personal life management desktop app",
    "longDescription": "ॐ is a lightweight personal productivity and life management desktop application for Windows.",
    "icon": [
      "icons/icon.ico",
      "icons/icon-256.png",
      "icons/icon-128.png",
      "icons/icon-64.png",
      "icons/icon-32.png",
      "icons/icon-16.png"
    ],
    "createUpdaterArtifacts": false,
    "android": {
      "versionCode": 1
    }
  }
}
